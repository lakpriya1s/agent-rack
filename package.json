{
  "name": "agent-rack",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) Server for running agy, claude, opencode, and CLI AI coding agents as tools",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakpriya1s/agent-rack.git"
  },
  "homepage": "https://github.com/lakpriya1s/agent-rack#readme",
  "bugs": {
    "url": "https://github.com/lakpriya1s/agent-rack/issues"
  },
  "bin": {
    "agent-rack": "bin/agent-rack.js"
  },
  "files": [
    "dist",
    "bin",
    "agent-rack.config.example.json",
    "README.md"
  ],
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "mcp",
    "agent",
    "antigravity",
    "claude-code",
    "opencode",
    "model-context-protocol"
  ],
  "author": "Lakpriya Senevirathna",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
