{
  "name": "agent-rack",
  "version": "0.11.0",
  "description": "MCP server that runs CLI AI coding agents (Claude Code, Codex, opencode, Antigravity) as sub-agents from any MCP client, with background sessions and structured code review",
  "type": "module",
  "main": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lakpriya1s/agent-rack.git"
  },
  "homepage": "https://github.com/lakpriya1s/agent-rack#readme",
  "bugs": {
    "url": "https://github.com/lakpriya1s/agent-rack/issues"
  },
  "bin": {
    "agent-rack": "bin/agent-rack.js"
  },
  "files": [
    "dist",
    "bin",
    "agent-rack.config.example.json",
    "plugins/agent-rack",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "clean": "rm -rf dist",
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "agent",
    "ai-agents",
    "sub-agents",
    "subagent",
    "multi-agent",
    "agent-orchestration",
    "coding-agent",
    "ai-coding-assistant",
    "claude",
    "claude-code",
    "claude-desktop",
    "codex",
    "codex-cli",
    "opencode",
    "antigravity",
    "cursor",
    "code-review",
    "cli",
    "developer-tools"
  ],
  "author": "Lakpriya Senevirathna",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "express": "^5.2.1",
    "ink": "^7.1.1",
    "node-pty": "^1.1.0",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
